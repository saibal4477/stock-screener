[
  {
    "name": "9EMA_Touch",
    "type": "long",
    "description": "Very Very Short Term Pullback to 9 EMA in structural uptrend",
    "conditions": [
      "close > sma_50",
      "sma_50 > sma_200",
      "structural_uptrend",
      "low <= ema_9",
      "high >= ema_9",
      "prev_close > prev_ema_9",
      "rsi < 60"
    ],
    "sl_formula": "min(support, close - min_atr_multiple_sl * atr)",
    "target_formula": "resistance - 0.50",
    "target_timeframe": "5-10 days"
  },
